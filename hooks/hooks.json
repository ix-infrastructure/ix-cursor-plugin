{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/prompt-briefing.js\"",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "matcher": "Grep",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/pre-search.js\"",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "matcher": "Write",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/edit-impact.js\"",
        "timeout": 10,
        "failClosed": false
      },
      {
        "matcher": "Grep",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/pre-search.js\"",
        "timeout": 10,
        "failClosed": false
      },
      {
        "matcher": "Shell",
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/shell-search.js\"",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/post-edit-ingest.js\"",
        "timeout": 5,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/mcp/dist/hooks/debounced-map.js\"",
        "timeout": 5,
        "failClosed": false
      }
    ]
  }
}
